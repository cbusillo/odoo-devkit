{
  "defaultBranch": "main",
  "projectType": "odoo-workspace-devkit",
  "docs": {
    "index": "docs/README.md",
    "overview": "README.md",
    "architecture": "docs/ARCHITECTURE.md",
    "roles": "docs/roles.md",
    "workspaceCli": "docs/tooling/workspace-cli.md",
    "artifactInputs": "docs/tooling/artifact-inputs.md",
    "buildToolUpgrades": "docs/tooling/build-tool-upgrades.md",
    "commandPatterns": "docs/tooling/command-patterns.md",
    "tenantOverlay": "docs/tooling/tenant-overlay.md",
    "pythonInspection": "docs/tooling/python-inspection.md",
    "addonCi": "docs/tooling/addon-ci.md",
    "consumerBuildChecks": "docs/tooling/consumer-build-checks.md"
  },
  "qualityGate": {
    "setup": {
      "default": "uv sync --locked"
    },
    "test": {
      "default": "uv run python -m unittest discover -s tests",
      "runtimePythonLock": "uv lock --check --offline --no-config --project docker/runtime-python",
      "addonCiLock": "uv lock --check --offline --no-config --project docker/addon-tests",
      "liveOdoo": "uv run python -m odoo_devkit.addon_ci --image <community-devtools-image> --addons-root tests/live_odoo/addons --support-root <sparse-shared-addons-checkout> --devkit-checks --output <task-evidence-directory>"
    },
    "format": {
      "default": "uv run ruff format --check ."
    },
    "lint": {
      "default": "uv run ruff check ."
    },
    "build": {
      "package": "uv build"
    },
    "smoke": {
      "cli": "uv run platform --help",
      "workspaceSurface": "uv run platform workspace sync --manifest <proof-workspace.toml>"
    },
    "inspection": {
      "ide": "PyCharm",
      "scopePreference": "changed_files",
      "prepare": {
        "python": {
          "version": "3.13",
          "moduleName": "odoo-devkit",
          "testRoots": [
            "tests"
          ],
          "sync": true,
          "requiredGeneratedState": [
            ".venv",
            ".idea"
          ]
        }
      }
    },
    "docsRequiredWhen": [
      "behavior changes",
      "api changes",
      "config changes",
      "operations changes",
      "ownership boundaries change",
      "workspace manifest contract changes",
      "workspace surface changes",
      "runtime command behavior changes",
      "tenant overlay template changes",
      "PyCharm generation changes"
    ]
  },
  "importantWorkflows": [
    "CI",
    "CodeQL",
    "Dependency Graph",
    "Dependabot Updates",
    "Devkit live Odoo checks"
  ],
  "prWorkflow": {
    "mergeMethod": "merge",
    "requiredStatusChecks": [
      "test"
    ],
    "additionalCiChecks": [
      "runtime-python-lock"
    ],
    "codeScanningMergeProtection": {
      "ruleset": "Require code scanning results",
      "tool": "CodeQL",
      "alertsThreshold": "errors",
      "securityAlertsThreshold": "high_or_higher"
    },
    "codeQualityMergeProtection": {
      "severity": "errors"
    },
    "requiresStrictStatusChecks": true
  },
  "relatedRepos": [
    "disable_odoo_online",
    "odoo-docker",
    "odoo-shared-addons",
    "odoo-tenant-cm",
    "odoo-tenant-opw",
    "launchplane"
  ],
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "available",
      "dependabotAlerts": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "metadataFreshness": {
    "updateWhen": [
      "docs routing changes",
      "validation gates change",
      "primary commands change",
      "important workflows change",
      "repo relationship changes",
      "cleanup policy changes",
      "ownership boundaries change",
      "workspace manifest contract changes",
      "runtime command behavior changes",
      "tenant overlay template changes",
      "branch protection or rulesets change"
    ]
  }
}
