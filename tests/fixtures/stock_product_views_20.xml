<odoo>
    <record id="product_template_form_view_stock" model="ir.ui.view">
        <field name="name">product.template.stock.property.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='is_storable']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="product_template_form_view_stock_account">
        <field name="name">view.template.property.form.stock.account</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_stock" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='serial_prefix_format']" position="before">
                <field name="lot_valuated" widget="confirm_boolean" invisible="store_by not in ['lot', 'serial']" />
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="product_template_hs_code">
        <field name="name">product.template.form.hs_code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_stock" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="inside">
                <field name="hs_code" invisible="product_variant_count != 1" />
                <field name="country_of_origin" invisible="product_variant_count != 1" />
            </xpath>
        </field>
    </record>
</odoo>
