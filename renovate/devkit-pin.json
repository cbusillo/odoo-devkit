{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Moves exact devkit pins and Odoo 20 shared-addons pins to their main head commits.",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^workspace\\.toml$/"],
      "matchStrings": [
        "\\[repos\\.(?:devkit|runtime)\\][^\\[]*?repository = \"(?<depName>cbusillo/odoo-devkit)\"[^\\[]*?ref = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "currentValueTemplate": "main",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: (?<depName>cbusillo/odoo-devkit)/[^@\\s]+@(?<currentDigest>[0-9a-f]{40})"
      ],
      "currentValueTemplate": "main",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "jsonata",
      "fileFormat": "toml",
      "managerFilePatterns": ["/^workspace\\.toml$/"],
      "matchStrings": [
        "$[build.odoo_version = '20.0'].repos.shared_addons[repository = 'cbusillo/odoo-shared-addons' and $exists(ref) and $contains(ref, /^[0-9a-f]{40}$/)].{'depName': repository, 'currentDigest': ref}"
      ],
      "currentValueTemplate": "main",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["cbusillo/odoo-devkit"],
      "commitMessageTopic": "odoo-devkit pin",
      "schedule": ["at any time"]
    },
    {
      "matchManagers": ["custom.jsonata"],
      "matchDepNames": ["cbusillo/odoo-shared-addons"],
      "commitMessageTopic": "shared-addons pin",
      "schedule": ["at any time"]
    }
  ]
}
